@page
@model HelpMuslimWebApp.IdentityServer.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Mot de passe oublié";
}
@if (Model.Sent)
{
    <header class="card__header">
        <span class="card__badge" aria-hidden="true">
            <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="3" /><path d="m4 7 8 6 8-6" /></svg>
        </span>
        <div>
            <h1>Vérifiez votre boîte mail</h1>
            <p class="subtitle">
                Si un compte Muslink existe pour <strong>@Model.Input.Email</strong>, vous allez recevoir un email avec un lien
                pour choisir un nouveau mot de passe. Il est valable 2 heures.
            </p>
        </div>
    </header>
    <p class="hint">Rien reçu après quelques minutes ? Regardez dans vos courriers indésirables, ou vérifiez l'adresse et refaites une demande.</p>
    <a class="btn btn--primary btn--cta" asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">
        Retour à la connexion
        <svg class="btn__arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </a>
}
else
{
    <h1>Mot de passe oublié</h1>
    <p class="subtitle">Indiquez l'adresse email de votre compte : nous vous envoyons un lien pour choisir un nouveau mot de passe.</p>

    <form method="post" asp-route-returnUrl="@Model.ReturnUrl" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert--error"></div>

        <label class="field">
            <span>Email</span>
            <div class="input">
                <svg class="input__icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3" /><path d="m4 7 8 6 8-6" /></svg>
                <input asp-for="Input.Email" type="email" autocomplete="email" autofocus placeholder="vous@exemple.fr" />
            </div>
            <span asp-validation-for="Input.Email" class="field__error"></span>
        </label>

        <button type="submit" class="btn btn--primary btn--cta">
            Recevoir le lien
            <svg class="btn__arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </button>
    </form>

    <p class="switch">
        Vous vous en souvenez ?
        <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Se connecter</a>
    </p>
}
