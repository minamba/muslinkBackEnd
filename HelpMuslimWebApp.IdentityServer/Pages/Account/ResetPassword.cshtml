@page
@model HelpMuslimWebApp.IdentityServer.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = Model.Done ? "Mot de passe modifié" : Model.Invalid ? "Lien invalide" : "Nouveau mot de passe";
}
@if (Model.Done)
{
    <header class="card__header">
        <span class="card__badge" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12.5 10 17l9-10" /></svg></span>
        <div>
            <h1>Mot de passe modifié</h1>
            <p class="subtitle">Votre nouveau mot de passe est enregistré : connectez-vous avec <strong>@Model.Email</strong>.</p>
        </div>
    </header>
    <a class="btn btn--primary btn--cta" href="@Model.ContinueUrl">
        Se connecter
        <svg class="btn__arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </a>
}
else if (Model.Invalid)
{
    <header class="card__header">
        <span class="card__badge" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 8v5M12 16.5v.5" /></svg></span>
        <div>
            <h1>Lien invalide ou expiré</h1>
            <p class="subtitle">Ce lien ne fonctionne plus : il est valable 2 heures et ne sert qu'une fois. Demandez-en un nouveau.</p>
        </div>
    </header>
    <a class="btn btn--primary btn--cta" asp-page="./ForgotPassword" asp-route-returnUrl="@Model.ReturnUrl" asp-route-email="@Model.Email">
        Recevoir un nouveau lien
        <svg class="btn__arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </a>
}
else
{
    <h1>Nouveau mot de passe</h1>
    <p class="subtitle">Choisissez le nouveau mot de passe de <strong>@Model.Email</strong>.</p>

    <form method="post" novalidate data-register-form>
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="Code" />
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="alert alert--error"></div>

        <label class="field">
            <span>Nouveau mot de passe</span>
            <div class="input password">
                <svg class="input__icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="3" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>
                <input asp-for="Input.Password" autocomplete="new-password" autofocus data-password-rules-input />
                <partial name="_PasswordToggle" />
            </div>
            <span asp-validation-for="Input.Password" class="field__error"></span>
        </label>

        @* Critères du mot de passe, cochés en direct (js/register.js, comme à l'inscription) *@
        <ul class="rules" data-password-rules>
            <li data-rule="length">8 caractères</li>
            <li data-rule="upper">Une majuscule</li>
            <li data-rule="lower">Une minuscule</li>
            <li data-rule="digit">Un chiffre</li>
            <li data-rule="special">Un caractère spécial</li>
        </ul>

        <label class="field">
            <span>Confirmer le mot de passe</span>
            <div class="input password">
                <svg class="input__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 5 6v5c0 4.4 3 8.3 7 10 4-1.7 7-5.6 7-10V6l-7-3Z" /><path d="m9 12 2 2 4-4" /></svg>
                <input asp-for="Input.ConfirmPassword" autocomplete="new-password" data-password-confirm />
                <partial name="_PasswordToggle" />
            </div>
            <span class="field__match" data-password-match hidden>Les mots de passe correspondent</span>
            <span asp-validation-for="Input.ConfirmPassword" class="field__error"></span>
        </label>

        <button type="submit" class="btn btn--primary btn--cta">
            Enregistrer le mot de passe
            <svg class="btn__arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </button>
    </form>
}

@section Scripts {
    <script src="~/js/register.js" asp-append-version="true" defer></script>
}
