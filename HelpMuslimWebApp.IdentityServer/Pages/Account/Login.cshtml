@page
@model HelpMuslimWebApp.IdentityServer.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Connexion";
}
<h1>Connexion</h1>
@if (Model.IsDemo)
{
    <p class="subtitle">Démonstration de Muslink : connectez-vous avec un compte de démo.</p>
}
else if (Model.Modes.RestrictsAccess)
{
    <p class="subtitle">Espace réservé aux administrateurs.</p>
    <partial name="_SiteModeNotice" model="Model.Modes" />
}
else
{
    <p class="subtitle">Accédez à votre espace candidat ou recruteur.</p>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert--error">@Model.ErrorMessage</div>
}

<form method="post" asp-route-returnUrl="@Model.ReturnUrl" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert--error"></div>

    <label class="field">
        <span>Email</span>
        <div class="input">
            <svg class="input__icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3" /><path d="m4 7 8 6 8-6" /></svg>
            <input asp-for="Input.Email" type="email" autocomplete="email" autofocus placeholder="vous@exemple.fr" />
        </div>
        <span asp-validation-for="Input.Email" class="field__error"></span>
    </label>

    <label class="field">
        <span>Mot de passe</span>
        <div class="input password">
            <svg class="input__icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="3" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>
            <input asp-for="Input.Password" autocomplete="current-password" />
            <partial name="_PasswordToggle" />
        </div>
        <span asp-validation-for="Input.Password" class="field__error"></span>
    </label>

    <div class="login-options">
        <label class="checkbox">
            <input asp-for="Input.RememberMe" />
            <span>Rester connecté</span>
        </label>
        @if (!Model.IsDemo)
        {
            <a class="login-options__forgot" asp-page="./ForgotPassword" asp-route-returnUrl="@Model.ReturnUrl">Mot de passe oublié ?</a>
        }
    </div>

    <button type="submit" class="btn btn--primary btn--cta">
        Se connecter
        <svg class="btn__arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </button>
</form>

<partial name="_ExternalLogins" model="(Model.ExternalLogins, Model.ReturnUrl)" />

@if (!Model.Modes.RestrictsAccess && !Model.IsDemo)
{
    <p class="switch">
        Pas encore de compte ?
        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Créer un compte</a>
    </p>
}
